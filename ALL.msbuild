<!-- MSBuild-Script for building FlashFolder and all dependent projects (x64 only) -->

<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<ItemGroup>
		<VCProject Include="commonUtils\CommonUtilsLib.vcxproj"/>
		<VCProject Include="Installer\wcautil\wcautil.vcxproj"/>
		<VCProject Include="Installer\CustomActions\CustomActions.vcxproj"/>
		<VCProject Include="common\CommonLib.vcxproj"/>
		<VCProject Include="FFConfig\FFConfig.vcxproj"/>
		<VCProject Include="FFLib\FFLib.vcxproj"/>
		<VCProject Include="FFService\FFService.vcxproj"/>
		<VCProject Include="FileMgrPlugin\FileMgrPlugin.vcxproj"/>
		<VCProject Include="Installer\MkVersionFile\MkVersionFile.vcxproj"/>
		<VCProject Include="Installer\Installer.vcxproj"/>
	</ItemGroup>

	<Target Name="Build">
		<Message Text="_______Building VC projects (x64)_______" Importance="high"/>
		<MSBuild Projects="@(VCProject)" Properties="Configuration=$(Configuration);Platform=x64"/>
	</Target>

	<Target Name="Clean">
		<MSBuild Targets="Clean" Projects="@(VCProject)" Properties="Configuration=$(Configuration);Platform=x64" />
	</Target>

	<Target Name="Rebuild" DependsOnTargets="Clean;Build"/>

</Project>